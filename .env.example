# ── 프론트엔드(Vite) 환경변수 ──────────────────────────────
# 배포된 백엔드의 origin. 비워두면 상대경로(/api/...)로 요청하며,
# 로컬 개발에서는 vite.config.ts의 proxy 설정이 이를 처리합니다.
# 프로덕션(Vercel)에서는 백엔드가 배포된 실제 URL을 넣어야 합니다.
VITE_API_BASE_URL=

# 실시간 스터디룸 (Supabase). 비워두면 스터디룸 탭이 "설정 필요" 상태로 표시됩니다.
# Supabase 프로젝트의 Settings > API에서 확인 (anon key는 공개용 키라 노출돼도 안전합니다).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 백엔드(server/index.js) 환경변수 ────────────────────────
# 값을 비워두면 mock 모드로 동작합니다 (실제 API 호출/결제 없음).

# AI 튜터 (Anthropic Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 아바타 상점 캐시 결제 (Stripe 테스트 모드)
# 실제 연동 시 `npm install stripe` 후 sk_test_ 로 시작하는 테스트 시크릿 키를 넣으세요.
STRIPE_SECRET_KEY=

# 배포된 프론트엔드 origin (CORS 허용 범위 제한용). 비워두면 전체 허용.
FRONTEND_ORIGIN=

PORT=3001
